rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isSuper() { return signedIn() && me().role == 'superadmin'; }
    function isAdmin() { return signedIn() && me().role in ['admin','superadmin']; }

    // staff accounts
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isSuper();
    }

    // username -> email lookup (must be readable before login)
    match /usernames/{name} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }

    match /products/{id}    { allow read, write: if signedIn(); }
    match /batches/{id}     { allow read, write: if signedIn(); }
    match /movements/{id}   { allow read, create: if signedIn(); }
    match /sales/{id}       { allow read, create: if signedIn(); }
    match /priceChanges/{id}{ allow read, create: if signedIn(); }

    // refunds: everyone signed in can read (the Sales report subtracts refunds),
    // only admins can create, and nobody can edit or delete a refund afterwards
    match /refunds/{id}     { allow read: if signedIn(); allow create: if isAdmin(); }

    match /categories/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /shops/{id}       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }
  }
}